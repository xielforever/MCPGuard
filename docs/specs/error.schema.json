{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpguard.example.invalid/specs/error.schema.json",
  "title": "MCPGuard management error envelope v1",
  "description": "Management HTTP errors only; native backend 401/403 must not become an MCP OAuth challenge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "requestId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fields": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "code"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
              }
            }
          }
        }
      }
    }
  }
}
