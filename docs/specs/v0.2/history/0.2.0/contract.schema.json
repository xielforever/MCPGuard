{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpguard.example/contracts/v0.2/contract.schema.json",
  "title": "MCPGuard v0.2 versioned contracts",
  "description": "Canonical source. RA-02 catalog; RA-03 reader is exercised only in a test harness. Credential and grant routes remain planned.",
  "$defs": {
    "UUID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 18,
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "Timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Cursor": {
      "type": "string",
      "maxLength": 512
    },
    "Kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "enum": [
        "POSTGRES",
        "REDIS",
        "HTTP"
      ]
    },
    "ResourceVersion": {
      "type": "object",
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "endpointConfigRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "targetFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "resourceId",
        "orgId",
        "version",
        "kind",
        "alias",
        "displayName",
        "endpointConfigRef",
        "targetFingerprint"
      ],
      "additionalProperties": false
    },
    "ResourceHead": {
      "type": "object",
      "properties": {
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "revision": {
          "$ref": "#/$defs/Version"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "orgId",
        "resourceId",
        "version",
        "revision",
        "enabled"
      ],
      "additionalProperties": false
    },
    "PermissionProfile": {
      "type": "object",
      "properties": {
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "allowedOperations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        },
        "nativeEnforcement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "PG_OWNER_RLS_V1",
            "REDIS_ACL",
            "HTTP_OPERATION"
          ]
        },
        "approvalPolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxResultBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1048576
        }
      },
      "required": [
        "orgId",
        "resourceId",
        "profileId",
        "version",
        "name",
        "allowedOperations",
        "nativeEnforcement",
        "approvalPolicyRef",
        "timeoutMs",
        "maxRows",
        "maxResultBytes"
      ],
      "additionalProperties": false
    },
    "ToolResourceBinding": {
      "type": "object",
      "properties": {
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "toolVersion": {
          "$ref": "#/$defs/Version"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      },
      "required": [
        "orgId",
        "resourceId",
        "resourceVersion",
        "profileId",
        "profileVersion",
        "toolName",
        "toolVersion",
        "operationId"
      ],
      "additionalProperties": false
    },
    "ResourceAccess": {
      "type": "object",
      "properties": {
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "principalId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "canDiscover": {
          "type": "boolean"
        },
        "canRequest": {
          "type": "boolean"
        }
      },
      "required": [
        "orgId",
        "principalId",
        "resourceId",
        "canDiscover",
        "canRequest"
      ],
      "additionalProperties": false
    },
    "ResourceView": {
      "type": "object",
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "revision": {
          "$ref": "#/$defs/Version"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "enabled": {
          "type": "boolean"
        },
        "canRequest": {
          "type": "boolean"
        },
        "accessState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "NOT_REQUESTED",
            "PENDING",
            "PROVISIONING",
            "ACTIVE",
            "REVOKED",
            "EXPIRED"
          ]
        }
      },
      "required": [
        "resourceId",
        "version",
        "revision",
        "kind",
        "alias",
        "displayName",
        "enabled",
        "canRequest",
        "accessState"
      ],
      "additionalProperties": false
    },
    "ListResourcesInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "after": {
          "$ref": "#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ListResourcesResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.2"
        },
        "resources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ResourceView"
          }
        },
        "nextAfter": {
          "$ref": "#/$defs/Cursor"
        }
      },
      "required": [
        "schemaVersion",
        "resources",
        "nextAfter"
      ],
      "additionalProperties": false
    },
    "GetResourceInput": {
      "type": "object",
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
        "resourceId"
      ],
      "additionalProperties": false
    },
    "GetResourceResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.2"
        },
        "resource": {
          "$ref": "#/$defs/ResourceView"
        },
        "profiles": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ProfileView"
          }
        }
      },
      "required": [
        "schemaVersion",
        "resource",
        "profiles"
      ],
      "additionalProperties": false
    },
    "RequestKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]{16,100}$"
    },
    "AccessRequestInput": {
      "type": "object",
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "requestedExpiry": {
          "$ref": "#/$defs/Timestamp"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestKey": {
          "$ref": "#/$defs/RequestKey"
        }
      },
      "required": [
        "resourceId",
        "profileId",
        "requestedExpiry",
        "reason",
        "requestKey"
      ],
      "additionalProperties": false
    },
    "AccessRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "ownerId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "requestedExpiry": {
          "$ref": "#/$defs/Timestamp"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "SUBMITTED",
            "PENDING_APPROVAL",
            "APPROVED",
            "REJECTED",
            "CANCELLED",
            "EXPIRED",
            "STALE"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "requestId",
        "orgId",
        "ownerId",
        "resourceId",
        "resourceVersion",
        "profileId",
        "profileVersion",
        "requestedExpiry",
        "reason",
        "requestHash",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "AccessDecision": {
      "type": "object",
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/UUID"
        },
        "requestId": {
          "$ref": "#/$defs/UUID"
        },
        "requestHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "requestRevision": {
          "$ref": "#/$defs/Version"
        },
        "deciderId": {
          "$ref": "#/$defs/UUID"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "HUMAN",
            "POLICY"
          ]
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "APPROVE",
            "REJECT"
          ]
        },
        "approvedExpiry": {
          "$ref": "#/$defs/Timestamp"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "decisionId",
        "requestId",
        "requestHash",
        "requestRevision",
        "deciderId",
        "source",
        "decision",
        "approvedExpiry",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "AccessGrant": {
      "type": "object",
      "properties": {
        "grantId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "subjectId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "accountId": {
          "$ref": "#/$defs/UUID"
        },
        "bindingId": {
          "$ref": "#/$defs/UUID"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "PROVISIONING",
            "ACTIVE",
            "PROVISIONING_UNKNOWN",
            "PROVISIONING_FAILED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "grantVersion": {
          "$ref": "#/$defs/Version"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "authEpoch": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "grantId",
        "orgId",
        "subjectId",
        "resourceId",
        "resourceVersion",
        "profileId",
        "profileVersion",
        "accountId",
        "bindingId",
        "state",
        "grantVersion",
        "expiresAt",
        "authEpoch"
      ],
      "additionalProperties": false
    },
    "ProvisioningJob": {
      "type": "object",
      "properties": {
        "jobId": {
          "$ref": "#/$defs/UUID"
        },
        "grantId": {
          "$ref": "#/$defs/UUID"
        },
        "accountPlanHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": [
            "READY",
            "EXECUTING",
            "VERIFIED",
            "OUTCOME_UNKNOWN",
            "FAILED",
            "CLEANUP_PENDING"
          ]
        },
        "providerReceiptRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "jobId",
        "grantId",
        "accountPlanHash",
        "state"
      ],
      "additionalProperties": false
    },
    "NativeAccount": {
      "type": "object",
      "properties": {
        "accountId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "subjectId": {
          "$ref": "#/$defs/UUID"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "nativeIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "managementMode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "PROVISIONED",
            "PREEXISTING"
          ]
        }
      },
      "required": [
        "accountId",
        "orgId",
        "resourceId",
        "subjectId",
        "profileId",
        "profileVersion",
        "nativeIdentity",
        "managementMode"
      ],
      "additionalProperties": false
    },
    "CredentialBinding": {
      "type": "object",
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "principalId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "bindingVersion": {
          "$ref": "#/$defs/Version"
        },
        "nativeIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "secretRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "secretVersion": {
          "$ref": "#/$defs/Version"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "bindingId",
        "orgId",
        "principalId",
        "resourceId",
        "resourceVersion",
        "profileId",
        "profileVersion",
        "bindingVersion",
        "nativeIdentity",
        "secretRef",
        "secretVersion",
        "enabled"
      ],
      "additionalProperties": false
    },
    "CredentialLease": {
      "type": "object",
      "properties": {
        "leaseId": {
          "$ref": "#/$defs/UUID"
        },
        "grantId": {
          "$ref": "#/$defs/UUID"
        },
        "grantVersion": {
          "$ref": "#/$defs/Version"
        },
        "credentialId": {
          "$ref": "#/$defs/UUID"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "ACTIVE",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "leaseId",
        "grantId",
        "grantVersion",
        "credentialId",
        "expiresAt",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "CredentialReference": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "string",
          "const": "1"
        },
        "credentialId": {
          "$ref": "#/$defs/UUID"
        },
        "leaseId": {
          "$ref": "#/$defs/UUID"
        },
        "orgId": {
          "$ref": "#/$defs/UUID"
        },
        "subjectId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceId": {
          "$ref": "#/$defs/UUID"
        },
        "resourceVersion": {
          "$ref": "#/$defs/Version"
        },
        "grantId": {
          "$ref": "#/$defs/UUID"
        },
        "grantVersion": {
          "$ref": "#/$defs/Version"
        },
        "bindingId": {
          "$ref": "#/$defs/UUID"
        },
        "bindingVersion": {
          "$ref": "#/$defs/Version"
        },
        "profileId": {
          "$ref": "#/$defs/UUID"
        },
        "profileVersion": {
          "$ref": "#/$defs/Version"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "issuerEpoch": {
          "$ref": "#/$defs/UUID"
        },
        "audience": {
          "type": "string",
          "const": "mcpguard-execution"
        },
        "issuedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "formatVersion",
        "credentialId",
        "leaseId",
        "orgId",
        "subjectId",
        "resourceId",
        "resourceVersion",
        "grantId",
        "grantVersion",
        "bindingId",
        "bindingVersion",
        "profileId",
        "profileVersion",
        "issuer",
        "issuerEpoch",
        "audience",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "CredentialEnvelope": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "string",
          "const": "1"
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9_-]{16}$"
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "authenticationTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      },
      "required": [
        "formatVersion",
        "issuer",
        "keyId",
        "nonce",
        "ciphertext",
        "authenticationTag"
      ],
      "additionalProperties": false
    },
    "DownloadTicket": {
      "type": "object",
      "properties": {
        "downloadId": {
          "$ref": "#/$defs/UUID"
        },
        "credentialId": {
          "$ref": "#/$defs/UUID"
        },
        "ownerId": {
          "$ref": "#/$defs/UUID"
        },
        "clientInstanceId": {
          "$ref": "#/$defs/UUID"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "enum": [
            "READY",
            "CLAIMED",
            "EXPIRED",
            "CANCELLED"
          ]
        }
      },
      "required": [
        "downloadId",
        "credentialId",
        "ownerId",
        "expiresAt",
        "state"
      ],
      "additionalProperties": false
    },
    "CredentialContext": {
      "type": "object",
