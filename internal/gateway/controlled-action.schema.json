{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCPGuard action control tools output v1",
  "description": "Public structured results of action.status/resume/cancel. Distinct from business ToolResult; an in-progress execution returns an ActionView, never a fake FINAL result.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/controlResult"
    },
    {
      "$ref": "#/$defs/controlError"
    }
  ],
  "$defs": {
    "actionIdInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "actionId"
      ]
    },
    "controlResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "requestId",
        "outcome",
        "action",
        "result",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "ACTION_CONTROL"
        },
        "operation": {
          "enum": [
            "STATUS",
            "RESUME",
            "CANCEL"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "enum": [
            "STATE_RETURNED",
            "APPROVAL_PENDING",
            "EXECUTION_IN_PROGRESS",
            "RESULT_RETURNED",
            "CANCELLATION_REQUESTED",
            "CANCELLED",
            "NOT_RESUMABLE"
          ]
        },
        "action": {
          "$ref": "#/$defs/actionView"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/toolResult/$defs/executionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/toolResult/$defs/safeError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "STATUS"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "STATE_RETURNED"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "RESUME"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "STATE_RETURNED",
                  "APPROVAL_PENDING",
                  "EXECUTION_IN_PROGRESS",
                  "RESULT_RETURNED",
                  "NOT_RESUMABLE"
                ]
              },
              "action": {
                "properties": {
                  "interactionMode": {
                    "const": "CONTROL_FLOW"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "CANCEL"
              }
            },
            "required": [
              "operation"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "CANCELLATION_REQUESTED",
                  "CANCELLED",
                  "NOT_RESUMABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "APPROVAL_PENDING"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "state": {
                    "const": "PENDING_APPROVAL"
                  }
                }
              },
              "result": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "EXECUTION_IN_PROGRESS"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "state": {
                    "const": "EXECUTING"
                  }
                }
              },
              "result": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "RESULT_RETURNED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/toolResult/$defs/executionResult"
              },
              "error": {
                "type": "null"
              },
              "action": {
                "properties": {
                  "state": {
                    "enum": [
                      "SUCCEEDED",
                      "FAILED",
                      "CANCELLED",
                      "OUTCOME_UNKNOWN"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "CANCELLATION_REQUESTED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "state": {
                    "const": "EXECUTING"
                  }
                }
              },
              "result": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "CANCELLED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "state": {
                    "const": "CANCELLED"
                  }
                }
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "NOT_RESUMABLE"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/toolResult/$defs/safeError"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "STATE_RETURNED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "operation": {
                    "const": "RESUME"
                  }
                },
                "required": [
                  "operation"
                ]
              },
              {
                "properties": {
                  "outcome": {
                    "const": "STATE_RETURNED"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "state": {
                    "enum": [
                      "SUCCEEDED",
                      "FAILED",
                      "CANCELLED",
                      "OUTCOME_UNKNOWN"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "controlError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "requestId",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "CONTROL_ERROR"
        },
        "operation": {
          "enum": [
            "STATUS",
            "RESUME",
            "CANCEL"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "error": {
          "$ref": "#/$defs/toolResult/$defs/safeError"
        }
      }
    },
    "toolResult": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MCPGuard business tool structured result v1",
      "description": "Design contract only. Validates structuredContent, not the MCP wire wrapper or authorization. No remote schema retrieval.",
      "oneOf": [
        {
          "$ref": "#/$defs/toolResult/$defs/executionResult"
        },
        {
          "$ref": "#/$defs/toolResult/$defs/deferredActionResult"
        }
      ],
      "$defs": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "actionState": {
          "enum": [
            "PENDING_APPROVAL",
            "READY",
            "EXECUTING",
            "SUCCEEDED",
            "FAILED",
            "DENIED",
            "CANCELLED",
            "EXPIRED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "requestStatus": {
          "enum": [
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "dispatchState": {
          "enum": [
            "NOT_DISPATCHED",
            "INTENT_RECORDED",
            "DISPATCHED",
            "DISPATCH_UNKNOWN"
          ]
        },
        "sideEffectStatus": {
          "enum": [
            "NONE",
            "APPLIED",
            "ROLLED_BACK",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "safeError": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "category",
            "safeMessage",
            "retryDisposition"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "category": {
              "enum": [
                "INPUT",
                "AUTHORIZATION",
                "POLICY",
                "APPROVAL",
                "EXECUTION",
                "DEPENDENCY",
                "CANCELLED",
                "CONFLICT",
                "OUTCOME_UNKNOWN"
              ]
            },
            "safeMessage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "nativeCode": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "retryDisposition": {
              "enum": [
                "NEVER",
                "QUERY_STATUS",
                "RECONCILE",
                "MANUAL_NEW_ACTION"
              ]
            }
          }
        },
        "executionResult": {
          "title": "ExecutionResult",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actionId",
            "attemptId",
            "executionId",
            "requestStatus",
            "dispatchState",
            "sideEffectStatus",
            "data",
            "error",
            "metadata"
          ],
          "properties": {
            "kind": {
              "const": "FINAL"
            },
            "actionId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attemptId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "executionId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requestStatus": {
              "enum": [
                "SUCCEEDED",
                "FAILED",
                "CANCELLED",
                "OUTCOME_UNKNOWN"
              ]
            },
            "dispatchState": {
              "enum": [
                "NOT_DISPATCHED",
                "DISPATCHED",
                "DISPATCH_UNKNOWN"
              ]
            },
            "sideEffectStatus": {
              "$ref": "#/$defs/toolResult/$defs/sideEffectStatus"
            },
            "data": true,
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/toolResult/$defs/safeError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "encoding": {
                  "enum": [
                    "utf-8",
                    "base64",
                    "json"
                  ]
                },
                "truncated": {
                  "type": "boolean"
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "resultExpiresAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "evidenceRef": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "actionId": {
                    "const": null
                  }
                },
                "required": [
                  "actionId"
                ]
              },
              "then": {
                "properties": {
                  "attemptId": {
                    "type": "null"
                  },
                  "executionId": {
                    "type": "null"
                  },
                  "requestStatus": {
                    "const": "FAILED"
                  },
                  "dispatchState": {
                    "const": "NOT_DISPATCHED"
                  },
                  "sideEffectStatus": {
                    "const": "NONE"
                  },
                  "data": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "executionId": {
                    "const": null
                  }
                },
                "required": [
                  "executionId"
                ]
              },
              "then": {
                "properties": {
                  "dispatchState": {
                    "const": "NOT_DISPATCHED"
                  },
                  "sideEffectStatus": {
                    "const": "NONE"
                  },
                  "requestStatus": {
                    "enum": [
                      "FAILED",
                      "CANCELLED"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "dispatchState": {
                    "const": "NOT_DISPATCHED"
                  }
                },
                "required": [
                  "dispatchState"
                ]
              },
              "then": {
                "properties": {
                  "sideEffectStatus": {
                    "const": "NONE"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "dispatchState": {
                    "const": "DISPATCH_UNKNOWN"
                  }
                },
                "required": [
                  "dispatchState"
                ]
              },
              "then": {
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "requestStatus": {
                    "const": "OUTCOME_UNKNOWN"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "dispatchState": {
                    "const": "DISPATCHED"
                  }
                },
                "required": [
                  "dispatchState"
                ]
              },
              "then": {
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "requestStatus": {
                    "const": "SUCCEEDED"
                  }
                },
                "required": [
                  "requestStatus"
                ]
              },
              "then": {
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dispatchState": {
                    "const": "DISPATCHED"
                  },
                  "sideEffectStatus": {
                    "enum": [
                      "NONE",
                      "APPLIED"
                    ]
                  },
                  "error": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "requestStatus": {
                    "enum": [
                      "FAILED",
                      "OUTCOME_UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "requestStatus"
                ]
              },
              "then": {
                "properties": {
                  "error": {
                    "$ref": "#/$defs/toolResult/$defs/safeError"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "requestStatus": {
                    "const": "OUTCOME_UNKNOWN"
                  }
                },
                "required": [
                  "requestStatus"
                ]
              },
              "then": {
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dispatchState": {
                    "enum": [
                      "DISPATCHED",
                      "DISPATCH_UNKNOWN"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "sideEffectStatus": {
                    "enum": [
                      "APPLIED",
                      "ROLLED_BACK",
                      "PARTIAL"
                    ]
                  }
                },
                "required": [
                  "sideEffectStatus"
                ]
              },
              "then": {
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "dispatchState": {
                    "const": "DISPATCHED"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "requestStatus": {
                    "enum": [
                      "FAILED",
                      "CANCELLED",
                      "OUTCOME_UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "requestStatus"
                ]
              },
              "then": {
                "properties": {
                  "data": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "deferredActionResult": {
          "title": "DeferredActionResult",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actionId",
            "attemptId",
            "state",
            "executionId",
            "dispatchState",
            "sideEffectStatus",
            "approvalUrl",
            "nextActions",
            "expiresAt"
          ],
          "properties": {
            "kind": {
              "const": "DEFERRED"
            },
            "actionId": {
              "type": "string",
              "format": "uuid"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "enum": [
                "PENDING_APPROVAL",
                "READY"
              ]
            },
            "executionId": {
              "type": "null"
            },
            "dispatchState": {
              "const": "NOT_DISPATCHED"
            },
            "sideEffectStatus": {
              "const": "NONE"
            },
            "approvalUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/web/",
              "maxLength": 2048
            },
            "nextActions": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "enum": [
                  "STATUS",
                  "RESUME",
                  "CANCEL"
                ]
              }
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "PENDING_APPROVAL"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "nextActions": {
                    "not": {
                      "contains": {
                        "const": "RESUME"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "type": "object"
    },
    "actionView": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "MCPGuard authorized ActionView v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "state",
        "authorizationSource",
        "interactionMode",
        "revision",
        "planHash",
        "toolName",
        "resourceId",
        "createdAt",
        "expiresAt",
        "executionId",
        "dispatchState",
        "requestStatus",
        "sideEffectStatus",
        "availableActions"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/toolResult/$defs/actionState"
        },
        "authorizationSource": {
          "enum": [
            null,
            "POLICY",
            "HUMAN"
          ]
        },
        "interactionMode": {
          "enum": [
            "BOUNDED_WAIT",
            "CONTROL_FLOW",
            "MRTR"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "planHash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "toolName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "requesterId": {
          "type": "string",
          "format": "uuid"
        },
        "requesterDisplayName": {
          "type": "string",
          "maxLength": 256
        },
        "resourceDisplayName": {
          "type": "string",
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "executionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "dispatchState": {
          "$ref": "#/$defs/toolResult/$defs/dispatchState"
        },
        "requestStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/toolResult/$defs/requestStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "sideEffectStatus": {
          "$ref": "#/$defs/toolResult/$defs/sideEffectStatus"
        },
        "availableActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "STATUS",
              "RESUME",
              "CANCEL",
              "APPROVE",
              "REJECT",
              "RECONCILE",
              "VIEW_RESULT"
            ]
          }
        },
        "terminalReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "self": {
              "type": "string",
              "format": "uri",
              "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/web/"
            },
            "approval": {
              "type": "string",
              "format": "uri",
              "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/web/"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "PENDING_APPROVAL",
                  "READY",
                  "DENIED",
